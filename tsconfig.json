{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@registry/*": ["./registry/*"],
      "@/lib/manga/*": ["./registry/manga/lib/*"],
      "@/components/ui/manga/*": ["./registry/manga/ui/*"],
      "@/components/manga/*": ["./registry/manga/signature/*"],
      "@/*": ["./site/src/*"]
    }
  },
  "include": ["site/src", "registry", "vite.config.ts"]
}
