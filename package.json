{
  "name": "mangacn",
  "version": "0.0.0",
  "private": true,
  "description": "A shadcn/ui registry that redraws shadcn in manga ink and screentone, with a webtoon theme.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "sync": "node scripts/sync-base.mjs && node scripts/llms.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "npm run sync && npm run typecheck && vite build && shadcn build -o site/dist/r",
    "preview": "vite preview",
    "shots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.80.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "playwright-core": "^1.65.1",
    "postcss": "^8.5.6",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
