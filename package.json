{
  "name": "mangacn",
  "version": "0.0.0",
  "private": true,
  "description": "A shadcn/ui registry that redraws shadcn in manga ink and screentone.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "sync": "node scripts/sync-base.mjs && node scripts/assemble-registry.mjs && node scripts/llms.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "npm run sync && npm run typecheck && vite build && shadcn build -o site/dist/r",
    "preview": "vite preview",
    "shots": "node scripts/screenshots.mjs",
    "check": "node scripts/check-items.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/dela-gothic-one": "^5.3.0",
    "@fontsource/patrick-hand-sc": "^5.3.0",
    "@fontsource/zen-kaku-gothic-new": "^5.3.1",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.80.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.24.2",
    "recharts": "^3.8.0",
    "shiki": "^4.6.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "playwright-core": "^1.65.1",
    "postcss": "^8.5.6",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
