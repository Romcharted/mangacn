# Hostinger (Apache / LiteSpeed). Copied as is to the root of the build.

AddType application/json .json
AddType text/plain .txt
AddDefaultCharset utf-8

<IfModule mod_headers.c>
  # Registry files and llms.txt are read by the shadcn CLI, its MCP server and AI tools.
  <FilesMatch "\.(json|txt)$">
    Header set Access-Control-Allow-Origin "*"
    Header set Cache-Control "public, max-age=300"
  </FilesMatch>
  # Vite gives scripts, styles and fonts a hashed name: they can be cached for good.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
