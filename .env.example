# Copy to .env.production.local (never committed) and fill in. Empty values turn the feature off.

# Hosting (see docs/deploy.md)
# BASE_PATH=/            # "/" at the root of the domain, "/mangacn/" in a folder; "./" by default
# SITE_URL=https://example.com/

# Umami statistics: both empty = no script at all
VITE_UMAMI_SRC=
VITE_UMAMI_WEBSITE_ID=
